model ParcelStatusTransition {
  id              Int            @id @default(autoincrement())
  parcelId        Int
  businessId      Int
  journeyId       Int?
  batchId         String         @db.Uuid
  fromStatus      DeliveryStatus
  toStatus        DeliveryStatus
  actorId         Int?
  reason          String?
  isCorrection    Boolean        @default(false)
  reversesBatchId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  parcel          Parcel         @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@index([parcelId, createdAt])
  @@index([businessId, batchId])
  @@index([journeyId])
}

model JourneyStatusTransition {
  id              Int           @id @default(autoincrement())
  journeyId       Int
  businessId      Int
  batchId         String        @db.Uuid
  fromStatus      JourneyStatus
  toStatus        JourneyStatus
  actorId         Int?
  reason          String?
  isCorrection    Boolean       @default(false)
  reversesBatchId String?       @db.Uuid
  createdAt       DateTime      @default(now())
  journey         Journey       @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@index([journeyId, createdAt])
  @@index([businessId, batchId])
}

