generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id Int @id @default(autoincrement())

  firstName String?
  lastName  String?
  email     String

  type         UserType @default(Member)
  isBlocked    Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  isDeleted    Boolean  @default(false)

  gender      Gender?
  dateOfBirth DateTime?

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  imageId  Int?
  imageUrl Image? @relation(fields: [imageId], references: [id])

  phoneId     Int?
  phoneNumber Phone? @relation(fields: [phoneId], references: [id])

  customerProfileId Int?             @unique
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])

  authProfiles            AuthProfile[]
  collectedParcelPayments ParcelPaymentEntry[] @relation("CollectedParcelPayments")
  recordedParcelPayments  ParcelPaymentEntry[] @relation("RecordedParcelPayments")
  parcelPriceChanges      ParcelPrice[]        @relation("ParcelPriceChangedBy")
  closedJourneys          Journey[]            @relation("JourneyClosedBy")

  courierProfile CourierProfile?
  driverProfile  DriverProfile?

  AuditLog            AuditLog[]
  customerNotes       CustomerNote[]
  parcelNotes         ParcelNote[]
  journeyNotes        JourneyNote[]
  courierJourneyNotes CourierJourneyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, email])
  @@index([businessId])
  @@index([customerProfileId])
}

model AuthProfile {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   AuthProvider
  providerId String

  email      String?
  phone      String?
  lastSignIn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
  @@index([email])
  @@index([phone])
}

model DriverProfile {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           Int       @unique
  isDeleted        Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id])
  journeys         Journey[] @relation("DriverProfileToJourney")
  parcelsPickedUp  Parcel[]  @relation("PickedUpByDriver")
  parcelsDelivered Parcel[]  @relation("DeliveredByDriver")
}

model CourierProfile {
  id               Int             @id @default(autoincrement())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userId           Int             @unique
  courierJourneyId Int?
  isDeleted        Boolean         @default(false)
  courierJourney   CourierJourney? @relation(fields: [courierJourneyId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  parcelsPickedUp  Parcel[]        @relation("PickedUpByCourier")
  parcelsDelivered Parcel[]        @relation("DeliveredByCourier")
}

model Business {
  id                      Int                      @id @default(autoincrement())
  name                    String
  notes                   String?
  activationDate          DateTime?
  isActive                Boolean                  @default(false)
  description             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  imageId                 Int?
  isDeleted               Boolean                  @default(false)
  currency                String                   @default("GBP")
  addresses               Address[]
  AuditLog                AuditLog[]
  imageUrl                Image?                   @relation(fields: [imageId], references: [id])
  courierJourney          CourierJourney[]
  customerProfiles        CustomerProfile[]
  journeys                Journey[]
  parcels                 Parcel[]
  tariffs                 Tariff[]
  tariffGroups            TariffGroup[]
  users                   User[]
  vehicles                Vehicle[]
  discounts               Discount[]
  pickupRequests          PickupRequest[]
  parcelTrackingSequences ParcelTrackingSequence[]
  shipments               Shipment[]
  parcelPaymentEntries    ParcelPaymentEntry[]
  parcelPaymentRequests   ParcelPaymentRequest[]
}

model ParcelTrackingSequence {
  businessId Int
  dateKey    String
  lastValue  Int      @default(0)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, dateKey])
}

model Shipment {
  id                         String                 @id @db.Uuid
  businessId                 Int
  createdAt                  DateTime               @default(now())
  verificationPostcode       String?
  verificationPostcodeSource String?
  business                   Business               @relation(fields: [businessId], references: [id])
  parcels                    Parcel[]
  trackingLinks              ShipmentTrackingLink[]

  @@unique([id, businessId])
  @@index([businessId])
}

model ShipmentTrackingLink {
  id         String    @id @default(uuid()) @db.Uuid
  shipmentId String    @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, revokedAt])
}

model ParcelCreationRequest {
  businessId  Int
  userId      Int
  key         String
  fingerprint String
  parcelIds   Int[]
  createdAt   DateTime @default(now())

  @@id([businessId, userId, key])
}

model TrackingRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model CustomerProfile {
  id                Int                       @id @default(autoincrement())
  businessId        Int
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  firstName         String?
  gender            Gender?
  lastName          String?
  email             String?
  isDeleted         Boolean                   @default(false)
  isActive          Boolean                   @default(true)
  phoneId           Int                       @unique
  addresses         Address[]
  business          Business                  @relation(fields: [businessId], references: [id])
  novaPostAddresses CustomerNovaPostAddress[]
  phoneNumber       Phone                     @relation(fields: [phoneId], references: [id])
  parcelsReceived   Parcel[]                  @relation("receivedParcels")
  parcelsSent       Parcel[]                  @relation("sentParcels")
  user              User?
  notes             CustomerNote[]

  @@index([businessId])
  @@index([email])
}

model CustomerNote {
  id                Int      @id @default(autoincrement())
  content           String
  customerProfileId Int
  userId            Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([customerProfileId])
  @@index([userId])
}

model ParcelNote {
  id        Int      @id @default(autoincrement())
  content   String
  parcelId  Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([parcelId])
  @@index([userId])
}

model JourneyNote {
  id        Int      @id @default(autoincrement())
  content   String
  journeyId Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([journeyId])
  @@index([userId])
}

model CourierJourneyNote {
  id               Int      @id @default(autoincrement())
  content          String
  courierJourneyId Int
  userId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courierJourney CourierJourney @relation(fields: [courierJourneyId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id])

  @@index([courierJourneyId])
  @@index([userId])
}

model Parcel {
  id                              Int                        @id @default(autoincrement())
  weight                          Decimal                    @db.Decimal(10, 3)
  trackingNumber                  String
  parcelMoneyAmount               Decimal?                   @db.Decimal(10, 2)
  price                           Decimal                    @default(0) @db.Decimal(10, 2)
  calculatedPrice                 Decimal?                   @db.Decimal(10, 2)
  isLost                          Boolean                    @default(false)
  isArchived                      Boolean                    @default(false)
  hasBorderCheck                  Boolean                    @default(false)
  isDamaged                       Boolean                    @default(false)
  deliveryStatus                  DeliveryStatus             @default(AtOriginWarehouse)
  paymentStatus                   PaymentStatus              @default(NotPaid)
  paymentCurrency                 String?
  paymentReconciliationState      PaymentReconciliationState @default(Reconciled)
  paidBy                          PaymentParty               @default(Sender)
  pickedUpByCourierId             Int?
  pickedUpByDriverId              Int?
  pickedUpAt                      DateTime?
  deliveredByCourierId            Int?
  deliveredByDriverId             Int?
  deliveredAt                     DateTime?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  senderId                        Int
  businessId                      Int
  journeyId                       Int?
  recipientId                     Int
  courierJourneyId                Int?
  isDeleted                       Boolean                    @default(false)
  parcelType                      ParcelType
  isPriceOverridden               Boolean                    @default(false)
  originType                      ParcelDestinationType      @default(CustomerAddress)
  destinationType                 ParcelDestinationType
  destinationAddressId            Int?
  customerNovaPostAddressId       Int?
  novaPostWarehouseId             Int?
  destinationSnapshot             Json?
  /// Immutable copy used for parcel history when a saved sender address changes.
  originSnapshot                  Json?
  novaPostTrackingNumber          String?
  originAddressId                 Int?
  originCustomerNovaPostAddressId Int?
  originNovaPostWarehouseId       Int?
  recipientPhoneNumber            String?
  senderPhoneNumber               String?
  groupId                         String?                    @db.Uuid
  shipmentId                      String?                    @db.Uuid
  shipment                        Shipment?                  @relation(fields: [shipmentId, businessId], references: [id, businessId], onDelete: Restrict)
  images                          Image[]
  prices                          ParcelPrice[]              @relation("ParcelPrices")
  business                        Business                   @relation(fields: [businessId], references: [id])
  courierJourney                  CourierJourney?            @relation(fields: [courierJourneyId], references: [id])
  destinationAddress              Address?                   @relation("destinationParcels", fields: [destinationAddressId], references: [id], onDelete: Restrict)
  customerNovaPostAddress         CustomerNovaPostAddress?   @relation("DestinationCustomerNovaPostAddress", fields: [customerNovaPostAddressId], references: [id], onDelete: Restrict)
  novaPostWarehouse               NovaPostWarehouse?         @relation("DestinationNovaPostWarehouse", fields: [novaPostWarehouseId], references: [id], onDelete: Restrict)
  journey                         Journey?                   @relation(fields: [journeyId], references: [id])
  originAddress                   Address?                   @relation("originParcels", fields: [originAddressId], references: [id], onDelete: Restrict)
  originCustomerNovaPostAddress   CustomerNovaPostAddress?   @relation("OriginCustomerNovaPostAddress", fields: [originCustomerNovaPostAddressId], references: [id], onDelete: Restrict)
  originNovaPostWarehouse         NovaPostWarehouse?         @relation("OriginNovaPostWarehouse", fields: [originNovaPostWarehouseId], references: [id], onDelete: Restrict)
  recipient                       CustomerProfile            @relation("receivedParcels", fields: [recipientId], references: [id])
  sender                          CustomerProfile            @relation("sentParcels", fields: [senderId], references: [id])
  pickedUpByCourier               CourierProfile?            @relation("PickedUpByCourier", fields: [pickedUpByCourierId], references: [id])
  pickedUpByDriver                DriverProfile?             @relation("PickedUpByDriver", fields: [pickedUpByDriverId], references: [id])
  deliveredByCourier              CourierProfile?            @relation("DeliveredByCourier", fields: [deliveredByCourierId], references: [id])
  deliveredByDriver               DriverProfile?             @relation("DeliveredByDriver", fields: [deliveredByDriverId], references: [id])
  parcelNotes                     ParcelNote[]
  paymentEntries                  ParcelPaymentEntry[]
  paymentRequests                 ParcelPaymentRequest[]
  statusTransitions               ParcelStatusTransition[]

  selectedPriceId Int?         @unique
  selectedPrice   ParcelPrice? @relation("SelectedParcelPrice", fields: [selectedPriceId], references: [id])

  @@unique([businessId, trackingNumber])
  @@index([selectedPriceId])
  @@index([groupId])
  @@index([shipmentId, businessId])
  @@index([businessId])
  @@index([senderId])
  @@index([recipientId])
  @@index([originType])
  @@index([destinationType])
  @@index([destinationAddressId])
  @@index([customerNovaPostAddressId])
  @@index([novaPostWarehouseId])
  @@index([originCustomerNovaPostAddressId])
  @@index([originNovaPostWarehouseId])
  @@index([parcelType])
  @@index([deliveryStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([pickedUpByCourierId])
  @@index([pickedUpByDriverId])
  @@index([deliveredByCourierId])
  @@index([deliveredByDriverId])
}

model Address {
  id                 Int             @id @default(autoincrement())
  street             String
  city               String?
  village            String?
  postcode           String?
  profileId          Int
  isPrimary          Boolean         @default(false)
  isActive           Boolean         @default(true)
  isDeleted          Boolean         @default(false)
  block              String?
  building           String?
  countryId          Int
  flat               String?
  note               String?
  region             String?
  line1              String?
  line2              String?
  line3              String?
  county             String?
  uprn               String?
  latitude           Decimal?        @db.Decimal(9, 6)
  longitude          Decimal?        @db.Decimal(9, 6)
  provider           String?
  providerRef        String?
  businessId         Int
  business           Business        @relation(fields: [businessId], references: [id])
  country            Country         @relation(fields: [countryId], references: [id])
  profile            CustomerProfile @relation(fields: [profileId], references: [id])
  destinationParcels Parcel[]        @relation("destinationParcels")
  originParcels      Parcel[]        @relation("originParcels")

  @@index([businessId])
  @@index([profileId])
  @@index([provider, providerRef])
}

model Phone {
  id          Int    @id @default(autoincrement())
  number      String
  countryCode String

  customerProfile CustomerProfile?
  users           User[]

  @@unique([countryCode, number])
}

model NovaPostWarehouse {
  id                 Int                       @id @default(autoincrement())
  externalRef        String                    @unique
  cityRef            String?
  areaRef            String?
  regionRef          String?
  warehouseNumber    String?
  name               String
  shortAddress       String?
  cityName           String
  areaName           String?
  regionName         String?
  warehouseType      String?
  isActive           Boolean                   @default(true)
  providerData       Json?
  customerAddresses  CustomerNovaPostAddress[]
  destinationParcels Parcel[]                  @relation("DestinationNovaPostWarehouse")
  originParcels      Parcel[]                  @relation("OriginNovaPostWarehouse")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([cityRef])
  @@index([cityName])
  @@index([warehouseNumber])
  @@index([isActive])
}

model CustomerNovaPostAddress {
  id                 Int               @id @default(autoincrement())
  customerProfileId  Int
  warehouseId        Int
  label              String?
  isDefault          Boolean           @default(false)
  note               String?
  recipientName      String?
  recipientPhone     String?
  customerProfile    CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  warehouse          NovaPostWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  destinationParcels Parcel[]          @relation("DestinationCustomerNovaPostAddress")
  originParcels      Parcel[]          @relation("OriginCustomerNovaPostAddress")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([customerProfileId, warehouseId])
  @@index([customerProfileId])
  @@index([warehouseId])
  @@index([customerProfileId, isDefault])
}

model CourierJourney {
  id                  Int                  @id @default(autoincrement())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isArchived          Boolean              @default(false)
  departureDate       DateTime
  isCompleted         Boolean              @default(false)
  isDeleted           Boolean              @default(false)
  businessId          Int
  vehicleId           Int
  destination         String
  business            Business             @relation(fields: [businessId], references: [id])
  vehicle             Vehicle              @relation(fields: [vehicleId], references: [id])
  courierProfiles     CourierProfile[]
  parcels             Parcel[]
  courierJourneyNotes CourierJourneyNote[]
}

model Journey {
  id                Int                       @id @default(autoincrement())
  journeyNumber     String                    @unique
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  departureDate     DateTime
  isCompleted       Boolean                   @default(false)
  status            JourneyStatus             @default(Scheduled)
  actualDepartureAt DateTime?
  arrivalDate       DateTime?
  closedAt          DateTime?
  closedByUserId    Int?
  closedBy          User?                     @relation("JourneyClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  vehicleId         Int
  businessId        Int
  isArchived        Boolean                   @default(false)
  startCountryId    Int
  endCountryId      Int
  hasTrailer        Boolean                   @default(false)
  isDeleted         Boolean                   @default(false)
  business          Business                  @relation(fields: [businessId], references: [id])
  vehicle           Vehicle                   @relation(fields: [vehicleId], references: [id])
  startCountry      Country                   @relation("JourneyStartCountry", fields: [startCountryId], references: [id])
  endCountry        Country                   @relation("JourneyEndCountry", fields: [endCountryId], references: [id])
  parcels           Parcel[]
  driverProfiles    DriverProfile[]           @relation("DriverProfileToJourney")
  journeyNotes      JourneyNote[]
  statusTransitions JourneyStatusTransition[]

  @@index([journeyNumber])
  @@index([businessId, departureDate])
  @@index([startCountryId])
  @@index([endCountryId])
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicleId Int?
  parcelId  Int?

  businesses Business[]
  parcel     Parcel?    @relation(fields: [parcelId], references: [id])
  vehicle    Vehicle?   @relation(fields: [vehicleId], references: [id])
  users      User[]
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isoCode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address      Address[]
  journeysFrom Journey[] @relation("JourneyStartCountry")
  journeysTo   Journey[] @relation("JourneyEndCountry")

  tariffGroupsFrom TariffGroup[] @relation("TariffGroupOriginCountry")
  tariffGroupsTo   TariffGroup[] @relation("TariffGroupDestinationCountry")

  discountsFrom Discount[] @relation("DiscountOriginCountry")
  discountsTo   Discount[] @relation("DiscountDestinationCountry")
}

model Vehicle {
  id             Int              @id @default(autoincrement())
  plateNumber    String
  model          String
  make           String
  year           Int
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  businessId     Int
  isDeleted      Boolean          @default(false)
  courierJourney CourierJourney[]
  images         Image[]
  journeys       Journey[]
  business       Business         @relation(fields: [businessId], references: [id])
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int?
  action      AuditAction
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  method      String?
  endpoint    String?
  requestId   String?
  duration    Int?
  statusCode  Int?
  businessId  Int?
  createdAt   DateTime    @default(now())
  business    Business?   @relation(fields: [businessId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([businessId])
  @@index([businessId, entityType, entityId, createdAt])
}

model Tariff {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean @default(true)
  businessId  Int
  isDeleted   Boolean @default(false)

  tariffGroupId Int?
  tariffGroup   TariffGroup? @relation(fields: [tariffGroupId], references: [id])

  parcelType ParcelType?

  minimumPrice    Decimal  @default(0) @db.Decimal(10, 2)
  pricePerKg      Decimal? @db.Decimal(10, 2)
  weightThreshold Decimal? @db.Decimal(10, 3)

  pricingType TariffPricingType @default(Fixed)

  business     Business      @relation(fields: [businessId], references: [id])
  parcelPrices ParcelPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([tariffGroupId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([parcelType])
  @@index([createdAt])
}

model TariffGroup {
  id         Int     @id @default(autoincrement())
  name       String
  isActive   Boolean @default(true)
  isDeleted  Boolean @default(false)
  businessId Int

  originCountryId      Int
  destinationCountryId Int

  business           Business      @relation(fields: [businessId], references: [id])
  originCountry      Country       @relation("TariffGroupOriginCountry", fields: [originCountryId], references: [id])
  destinationCountry Country       @relation("TariffGroupDestinationCountry", fields: [destinationCountryId], references: [id])
  tariffs            Tariff[]
  parcelPrices       ParcelPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, originCountryId, destinationCountryId])
  @@index([businessId])
  @@index([isActive])
  @@index([isDeleted])
}

model ParcelPrice {
  id Int @id @default(autoincrement())

  parcelId      Int
  tariffId      Int?
  tariffGroupId Int?

  selectedForParcel Parcel? @relation("SelectedParcelPrice")

  parcel      Parcel       @relation("ParcelPrices", fields: [parcelId], references: [id], onDelete: Cascade)
  tariff      Tariff?      @relation(fields: [tariffId], references: [id])
  tariffGroup TariffGroup? @relation(fields: [tariffGroupId], references: [id])

  label String

  currency String

  baseAmount     Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  finalAmount    Decimal @db.Decimal(10, 2)

  isSelected   Boolean @default(false)
  isOverridden Boolean @default(false)

  parcelType ParcelType
  weight     Decimal    @db.Decimal(10, 3)

  tariffName      String?
  tariffGroupName String?
  pricingType     TariffPricingType
  fixedPrice      Decimal?          @db.Decimal(10, 2)
  minimumPrice    Decimal?          @db.Decimal(10, 2)
  pricePerKg      Decimal?          @db.Decimal(10, 2)
  weightThreshold Decimal?          @db.Decimal(10, 3)

  discounts      ParcelPriceDiscount[]
  paymentEntries ParcelPaymentEntry[]

  changeReason    String?
  changedByUserId Int?
  changedBy       User?   @relation("ParcelPriceChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  originCountryId      Int?
  destinationCountryId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parcelId])
  @@index([tariffId])
  @@index([tariffGroupId])
  @@index([parcelId, isSelected])
  @@index([originCountryId])
  @@index([destinationCountryId])
  @@index([changedByUserId])
}

model ParcelPaymentEntry {
  id                 Int                    @id @default(autoincrement())
  businessId         Int
  parcelId           Int
  parcelPriceId      Int
  kind               ParcelPaymentEntryKind
  amount             Decimal                @db.Decimal(10, 2)
  currency           String
  method             ParcelPaymentMethod?
  payerParty         PaymentParty?
  collectorId        Int?
  recordedById       Int?
  note               String?
  reason             String?
  reversesEntryId    Int?                   @unique
  replacementEntryId Int?                   @unique
  createdAt          DateTime               @default(now())

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parcel           Parcel              @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  parcelPrice      ParcelPrice         @relation(fields: [parcelPriceId], references: [id], onDelete: Restrict)
  collector        User?               @relation("CollectedParcelPayments", fields: [collectorId], references: [id], onDelete: Restrict)
  recordedBy       User?               @relation("RecordedParcelPayments", fields: [recordedById], references: [id], onDelete: Restrict)
  reversesEntry    ParcelPaymentEntry? @relation("PaymentReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversalEntry    ParcelPaymentEntry? @relation("PaymentReversal")
  replacementEntry ParcelPaymentEntry? @relation("PaymentReplacement", fields: [replacementEntryId], references: [id], onDelete: Restrict)
  replacementOf    ParcelPaymentEntry? @relation("PaymentReplacement")

  @@index([businessId, parcelId, createdAt])
  @@index([parcelPriceId])
  @@index([collectorId])
  @@index([recordedById])
}

model ParcelPaymentRequest {
  businessId      Int
  idempotencyKey  String
  parcelId        Int
  operation       String
  fingerprint     String
  responsePayload Json
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parcel   Parcel   @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@id([businessId, idempotencyKey])
  @@index([parcelId])
}

model ParcelPriceDiscount {
  id Int @id @default(autoincrement())

  parcelPriceId Int
  discountId    Int?

  parcelPrice ParcelPrice @relation(fields: [parcelPriceId], references: [id], onDelete: Cascade)
  discount    Discount?   @relation(fields: [discountId], references: [id])

  name           String
  code           String?
  discountType   DiscountType   @default(None)
  discountReason DiscountReason @default(Manual)
  value          Decimal        @db.Decimal(10, 2)
  amount         Decimal        @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([parcelPriceId])
  @@index([discountId])
}

model Discount {
  id Int @id @default(autoincrement())

  name        String
  description String?
  code        String?

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  discountType   DiscountType   @default(None)
  discountReason DiscountReason @default(Manual)
  value          Decimal        @db.Decimal(10, 2)

  parcelType ParcelType?

  originCountryId      Int?
  destinationCountryId Int?

  originCountry      Country? @relation("DiscountOriginCountry", fields: [originCountryId], references: [id])
  destinationCountry Country? @relation("DiscountDestinationCountry", fields: [destinationCountryId], references: [id])

  minimumAmount Decimal? @db.Decimal(10, 2)
  minimumWeight Decimal? @db.Decimal(10, 3)
  maximumWeight Decimal? @db.Decimal(10, 3)

  minParcelCount   Int?
  isForSubscribers Boolean @default(false)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  startsAt DateTime?
  endsAt   DateTime?

  stackable Boolean @default(false)
  priority  Int     @default(0)

  parcelPriceDiscounts ParcelPriceDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([parcelType])
  @@index([originCountryId])
  @@index([destinationCountryId])
  @@index([createdAt])
}

model PickupRequest {
  id            Int                 @id @default(autoincrement())
  businessId    Int
  customerName  String
  phoneNumber   String
  postcode      String
  parcelCount   Int                 @default(1)
  scheduledDate DateTime
  status        PickupRequestStatus @default(Pending)
  notes         String?
  isDeleted     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([businessId, scheduledDate])
  @@index([status])
  @@index([createdAt])
}

