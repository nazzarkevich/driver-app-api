generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id Int @id @default(autoincrement())

  firstName String?
  lastName  String?
  email     String

  type         UserType @default(Member)
  isBlocked    Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  isDeleted    Boolean  @default(false)

  gender      Gender?
  dateOfBirth DateTime?

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  imageId  Int?
  imageUrl Image? @relation(fields: [imageId], references: [id])

  phoneId     Int?
  phoneNumber Phone? @relation(fields: [phoneId], references: [id])

  customerProfileId Int?             @unique
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])

  authProfiles AuthProfile[]

  courierProfile CourierProfile?
  driverProfile  DriverProfile?

  AuditLog            AuditLog[]
  customerNotes       CustomerNote[]
  parcelNotes         ParcelNote[]
  journeyNotes        JourneyNote[]
  courierJourneyNotes CourierJourneyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, email])
  @@index([businessId])
  @@index([customerProfileId])
}

model AuthProfile {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   AuthProvider
  providerId String

  email      String?
  phone      String?
  lastSignIn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
  @@index([email])
  @@index([phone])
}

model DriverProfile {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           Int       @unique
  isDeleted        Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id])
  journeys         Journey[] @relation("DriverProfileToJourney")
  parcelsPickedUp  Parcel[]  @relation("PickedUpByDriver")
  parcelsDelivered Parcel[]  @relation("DeliveredByDriver")
}

model CourierProfile {
  id               Int             @id @default(autoincrement())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userId           Int             @unique
  courierJourneyId Int?
  isDeleted        Boolean         @default(false)
  courierJourney   CourierJourney? @relation(fields: [courierJourneyId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  parcelsPickedUp  Parcel[]        @relation("PickedUpByCourier")
  parcelsDelivered Parcel[]        @relation("DeliveredByCourier")
}

model Business {
  id               Int               @id @default(autoincrement())
  name             String
  notes            String?
  activationDate   DateTime?
  isActive         Boolean           @default(false)
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  imageId          Int?
  isDeleted        Boolean           @default(false)
  addresses        Address[]
  AuditLog         AuditLog[]
  imageUrl         Image?            @relation(fields: [imageId], references: [id])
  courierJourney   CourierJourney[]
  customerProfiles CustomerProfile[]
  journeys         Journey[]
  parcels          Parcel[]
  tariffs          Tariff[]
  users            User[]
  vehicles         Vehicle[]
  discounts        Discount[]
  pickupRequests   PickupRequest[]
}

model CustomerProfile {
  id                Int              @id @default(autoincrement())
  businessId        Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  firstName         String?
  gender            Gender?
  lastName          String?
  email             String?
  isDeleted         Boolean          @default(false)
  isActive          Boolean          @default(true)
  novaPostAddressId Int?
  phoneId           Int              @unique
  addresses         Address[]
  business          Business         @relation(fields: [businessId], references: [id])
  novaPostAddress   NovaPostAddress? @relation(fields: [novaPostAddressId], references: [id])
  phoneNumber       Phone            @relation(fields: [phoneId], references: [id])
  parcelsReceived   Parcel[]         @relation("receivedParcels")
  parcelsSent       Parcel[]         @relation("sentParcels")
  user              User?
  notes             CustomerNote[]

  @@index([businessId])
  @@index([email])
}

model CustomerNote {
  id                Int      @id @default(autoincrement())
  content           String
  customerProfileId Int
  userId            Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([customerProfileId])
  @@index([userId])
}

model ParcelNote {
  id        Int      @id @default(autoincrement())
  content   String
  parcelId  Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([parcelId])
  @@index([userId])
}

model JourneyNote {
  id        Int      @id @default(autoincrement())
  content   String
  journeyId Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([journeyId])
  @@index([userId])
}

model CourierJourneyNote {
  id               Int      @id @default(autoincrement())
  content          String
  courierJourneyId Int
  userId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courierJourney CourierJourney @relation(fields: [courierJourneyId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id])

  @@index([courierJourneyId])
  @@index([userId])
}

model Parcel {
  id                     Int              @id @default(autoincrement())
  weight                 Decimal          @db.Decimal(10, 3)
  trackingNumber         String
  parcelMoneyAmount      Decimal?         @db.Decimal(10, 2)
  price                  Decimal          @default(0) @db.Decimal(10, 2)
  cost                   Decimal          @default(0) @db.Decimal(10, 2)
  calculatedPrice        Decimal?         @db.Decimal(10, 2)
  isLost                 Boolean          @default(false)
  pickupDate             DateTime         @default(now())
  deliveryDate           DateTime?
  isArchived             Boolean          @default(false)
  hasBorderCheck         Boolean          @default(false)
  isDamaged              Boolean          @default(false)
  deliveryStatus         DeliveryStatus   @default(Initial)
  paymentStatus          PaymentStatus    @default(NotPaid)
  paidBy                 PaymentParty     @default(Sender)
  pickedUpByCourierId    Int?
  pickedUpByDriverId     Int?
  pickedUpAt             DateTime?
  deliveredByCourierId   Int?
  deliveredByDriverId    Int?
  deliveredAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  senderId               Int
  businessId             Int
  journeyId              Int?
  recipientId            Int
  courierJourneyId       Int?
  isDeleted              Boolean          @default(false)
  parcelType             ParcelType
  isPriceOverridden      Boolean          @default(false)
  destinationAddressId   Int
  novaPostAddressId      Int?
  novaPostTrackingNumber String?
  originAddressId        Int
  recipientPhoneNumber   String?
  senderPhoneNumber      String?
  groupId                String?          @db.Uuid
  images                 Image[]
  prices                 ParcelPrice[]    @relation("ParcelPrices")
  business               Business         @relation(fields: [businessId], references: [id])
  courierJourney         CourierJourney?  @relation(fields: [courierJourneyId], references: [id])
  destinationAddress     Address          @relation("destinationParcels", fields: [destinationAddressId], references: [id])
  journey                Journey?         @relation(fields: [journeyId], references: [id])
  novaPostAddress        NovaPostAddress? @relation(fields: [novaPostAddressId], references: [id])
  originAddress          Address          @relation("originParcels", fields: [originAddressId], references: [id])
  recipient              CustomerProfile  @relation("receivedParcels", fields: [recipientId], references: [id])
  sender                 CustomerProfile  @relation("sentParcels", fields: [senderId], references: [id])
  pickedUpByCourier      CourierProfile?  @relation("PickedUpByCourier", fields: [pickedUpByCourierId], references: [id])
  pickedUpByDriver       DriverProfile?   @relation("PickedUpByDriver", fields: [pickedUpByDriverId], references: [id])
  deliveredByCourier     CourierProfile?  @relation("DeliveredByCourier", fields: [deliveredByCourierId], references: [id])
  deliveredByDriver      DriverProfile?   @relation("DeliveredByDriver", fields: [deliveredByDriverId], references: [id])
  parcelNotes            ParcelNote[]

  selectedPriceId Int?
  selectedPrice   ParcelPrice? @relation("SelectedParcelPrice", fields: [selectedPriceId], references: [id])

  @@unique([businessId, trackingNumber])
  @@index([selectedPriceId])
  @@index([groupId])
  @@index([businessId])
  @@index([senderId])
  @@index([recipientId])
  @@index([parcelType])
  @@index([deliveryStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([pickedUpByCourierId])
  @@index([pickedUpByDriverId])
  @@index([deliveredByCourierId])
  @@index([deliveredByDriverId])
}

model Address {
  id                 Int             @id @default(autoincrement())
  street             String
  city               String?
  village            String?
  postcode           String?
  profileId          Int
  isPrimary          Boolean         @default(false)
  block              String?
  building           String?
  countryId          Int
  flat               String?
  note               String?
  region             String?
  businessId         Int
  business           Business        @relation(fields: [businessId], references: [id])
  country            Country         @relation(fields: [countryId], references: [id])
  profile            CustomerProfile @relation(fields: [profileId], references: [id])
  destinationParcels Parcel[]        @relation("destinationParcels")
  originParcels      Parcel[]        @relation("originParcels")

  @@index([businessId])
  @@index([profileId])
}

model Phone {
  id          Int    @id @default(autoincrement())
  number      String
  countryCode String

  customerProfile CustomerProfile?
  users           User[]

  @@unique([countryCode, number])
}

model NovaPostAddress {
  id                 Int               @id @default(autoincrement())
  city               String
  Area               String
  MainDescription    String
  Region             String
  SettlementTypeCode String
  Warehouses         String
  street             String
  customerProfile    CustomerProfile[]
  parcel             Parcel[]
}

model CourierJourney {
  id                  Int                  @id @default(autoincrement())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isArchived          Boolean              @default(false)
  departureDate       DateTime
  isCompleted         Boolean              @default(false)
  isDeleted           Boolean              @default(false)
  businessId          Int
  vehicleId           Int
  destination         String
  business            Business             @relation(fields: [businessId], references: [id])
  vehicle             Vehicle              @relation(fields: [vehicleId], references: [id])
  courierProfiles     CourierProfile[]
  parcels             Parcel[]
  courierJourneyNotes CourierJourneyNote[]
}

model Journey {
  id             Int             @id @default(autoincrement())
  journeyNumber  String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  departureDate  DateTime
  isCompleted    Boolean         @default(false)
  arrivalDate    DateTime?
  vehicleId      Int
  businessId     Int
  isArchived     Boolean         @default(false)
  startCountryId Int
  endCountryId   Int
  hasTrailer     Boolean         @default(false)
  isDeleted      Boolean         @default(false)
  business       Business        @relation(fields: [businessId], references: [id])
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  startCountry   Country         @relation("JourneyStartCountry", fields: [startCountryId], references: [id])
  endCountry     Country         @relation("JourneyEndCountry", fields: [endCountryId], references: [id])
  parcels        Parcel[]
  driverProfiles DriverProfile[] @relation("DriverProfileToJourney")
  journeyNotes   JourneyNote[]

  @@index([journeyNumber])
  @@index([businessId, departureDate])
  @@index([startCountryId])
  @@index([endCountryId])
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicleId Int?
  parcelId  Int?

  businesses Business[]
  parcel     Parcel?    @relation(fields: [parcelId], references: [id])
  vehicle    Vehicle?   @relation(fields: [vehicleId], references: [id])
  users      User[]
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isoCode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address      Address[]
  journeysFrom Journey[] @relation("JourneyStartCountry")
  journeysTo   Journey[] @relation("JourneyEndCountry")

  tariffsFrom Tariff[] @relation("TariffOriginCountry")
  tariffsTo   Tariff[] @relation("TariffDestinationCountry")

  discountsFrom Discount[] @relation("DiscountOriginCountry")
  discountsTo   Discount[] @relation("DiscountDestinationCountry")
}

model Vehicle {
  id             Int              @id @default(autoincrement())
  plateNumber    String
  model          String
  make           String
  year           Int
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  businessId     Int
  isDeleted      Boolean          @default(false)
  courierJourney CourierJourney[]
  images         Image[]
  journeys       Journey[]
  business       Business         @relation(fields: [businessId], references: [id])
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int?
  action      AuditAction
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  method      String?
  endpoint    String?
  requestId   String?
  duration    Int?
  statusCode  Int?
  businessId  Int?
  createdAt   DateTime    @default(now())
  business    Business?   @relation(fields: [businessId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([businessId])
}

model Tariff {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  currency    String  @default("GBP")

  isActive   Boolean @default(true)
  businessId Int
  isDeleted  Boolean @default(false)

  parcelType ParcelType?

  originCountryId      Int?
  destinationCountryId Int?

  originCountry      Country? @relation("TariffOriginCountry", fields: [originCountryId], references: [id])
  destinationCountry Country? @relation("TariffDestinationCountry", fields: [destinationCountryId], references: [id])

  fixedPrice      Decimal? @db.Decimal(10, 2)
  minimumPrice    Decimal  @default(0) @db.Decimal(10, 2)
  pricePerKg      Decimal? @db.Decimal(10, 2)
  weightThreshold Decimal? @db.Decimal(10, 3)

  pricingType TariffPricingType @default(Fixed)
  priority    Int               @default(0)

  business     Business      @relation(fields: [businessId], references: [id])
  parcelPrices ParcelPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([parcelType])
  @@index([originCountryId])
  @@index([destinationCountryId])
  @@index([priority])
  @@index([createdAt])
}

model ParcelPrice {
  id Int @id @default(autoincrement())

  parcelId Int
  tariffId Int?

  selectedForParcels Parcel[] @relation("SelectedParcelPrice")

  parcel Parcel  @relation("ParcelPrices", fields: [parcelId], references: [id], onDelete: Cascade)
  tariff Tariff? @relation(fields: [tariffId], references: [id])

  label String

  currency String

  baseAmount     Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  finalAmount    Decimal @db.Decimal(10, 2)

  isSelected   Boolean @default(false)
  isOverridden Boolean @default(false)

  parcelType ParcelType
  weight     Decimal    @db.Decimal(10, 3)

  tariffName      String?
  pricingType     TariffPricingType
  fixedPrice      Decimal?          @db.Decimal(10, 2)
  minimumPrice    Decimal?          @db.Decimal(10, 2)
  pricePerKg      Decimal?          @db.Decimal(10, 2)
  weightThreshold Decimal?          @db.Decimal(10, 3)

  discounts ParcelPriceDiscount[]

  originCountryId      Int?
  destinationCountryId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parcelId])
  @@index([tariffId])
  @@index([parcelId, isSelected])
  @@index([originCountryId])
  @@index([destinationCountryId])
}

model ParcelPriceDiscount {
  id Int @id @default(autoincrement())

  parcelPriceId Int
  discountId    Int?

  parcelPrice ParcelPrice @relation(fields: [parcelPriceId], references: [id], onDelete: Cascade)
  discount    Discount?   @relation(fields: [discountId], references: [id])

  name           String
  code           String?
  discountType   DiscountType   @default(None)
  discountReason DiscountReason @default(Manual)
  value          Decimal        @db.Decimal(10, 2)
  amount         Decimal        @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([parcelPriceId])
  @@index([discountId])
}

model Discount {
  id Int @id @default(autoincrement())

  name        String
  description String?
  code        String?

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  discountType   DiscountType   @default(None)
  discountReason DiscountReason @default(Manual)
  value          Decimal        @db.Decimal(10, 2)

  parcelType ParcelType?

  originCountryId      Int?
  destinationCountryId Int?

  originCountry      Country? @relation("DiscountOriginCountry", fields: [originCountryId], references: [id])
  destinationCountry Country? @relation("DiscountDestinationCountry", fields: [destinationCountryId], references: [id])

  minimumAmount Decimal? @db.Decimal(10, 2)
  minimumWeight Decimal? @db.Decimal(10, 3)
  maximumWeight Decimal? @db.Decimal(10, 3)

  minParcelCount   Int?
  isForSubscribers Boolean @default(false)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  startsAt DateTime?
  endsAt   DateTime?

  stackable Boolean @default(false)
  priority  Int     @default(0)

  parcelPriceDiscounts ParcelPriceDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([parcelType])
  @@index([originCountryId])
  @@index([destinationCountryId])
  @@index([createdAt])
}

model PickupRequest {
  id            Int                 @id @default(autoincrement())
  businessId    Int
  customerName  String
  phoneNumber   String
  postcode      String
  parcelCount   Int                 @default(1)
  scheduledDate DateTime
  status        PickupRequestStatus @default(Pending)
  notes         String?
  isDeleted     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([businessId, scheduledDate])
  @@index([status])
  @@index([createdAt])
}

enum PickupRequestStatus {
  Pending
  Collected
  Converted
  Cancelled
}

enum UserType {
  Moderator
  Customer
  Manager
  Member
  InternationalDriver
  ParcelCourier
  Subscriber
}

enum Gender {
  Male
  Female
}

enum ParcelType {
  Regular
  Passport
  Document
  Money
}

enum DiscountType {
  None
  Percentage
  FixedAmount
}

enum DeliveryStatus {
  Initial
  InProgress
  Delivered
  Cancelled
  Returned
  Lost
}

enum PaymentStatus {
  NotPaid
  PartiallyPaid
  Paid
}

enum PaymentParty {
  Sender
  Recipient
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SIGNUP
  PASSWORD_CHANGE
  ROLE_CHANGE
  PROFILE_UPDATE
  UPLOAD_FILE
  DOWNLOAD_FILE
  EXPORT_DATA
  IMPORT_DATA
  ARCHIVE
  RESTORE
  APPROVE
  REJECT
  ASSIGN
  UNASSIGN
  BLOCK
  UNBLOCK
  CUSTOM
}

enum TariffPricingType {
  Fixed
  PerKg
  PerKgWithMinimum
}

enum DiscountReason {
  Manual
  Subscriber
  Referral
  FirstTimePurchase
  PromoCode
}

enum AuthProvider {
  Supabase
  Google
  Apple
  EmailPassword
}
